name: Shadowrocket

on:
  push:
    branches:
      - master
      - main
    paths:
      - 'qx/**'
      - 'qxb/**'
      - '.github/workflows/convert.yml'
  schedule:
    # 每天 UTC 00:00 (北京时间 08:00) 自动定时运行
    - cron: '0 0 * * *'
  workflow_dispatch: # 支持在 GitHub 页面手动点击触发

jobs:
  build-and-convert:
    runs-on: ubuntu-latest
    permissions:
      contents: write

    steps:
      - name: Checkout Repository
        uses: actions/checkout@v5

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.x'

      - name: Inline Convert Script
        run: |
          python -c "
          import os

          def clean_and_convert_line(line):
              line = line.strip()
              # 保留注释行
              if line.startswith('#') or line.startswith(';'):
                  return line
              if not line:
                  return None

              parts = [p.strip() for p in line.split(',') if p.strip()]
              if len(parts) >= 2:
                  rule_type = parts[0].upper()
                  domain = parts[1].strip()

                  # DOMAIN-SET 扩展匹配：以 '.' 开头表示包含自身及全部子域名
                  if rule_type in ('HOST-SUFFIX', 'DOMAIN-SUFFIX'):
                      return f'.{domain.lstrip(\".\")}'
                  
                  # DOMAIN-SET 精确匹配：无 '.' 前缀仅匹配该单条域名
                  elif rule_type in ('HOST', 'DOMAIN'):
                      return domain.lstrip('.')

              # DOMAIN-SET 纯域名集合不支持 HOST-KEYWORD, IP-CIDR, USER-AGENT 等规则，自动忽略
              return None

          def process_file(input_path, output_path):
              try:
                  with open(input_path, 'r', encoding='utf-8') as f:
                      lines = f.readlines()
              except UnicodeDecodeError:
                  with open(input_path, 'r', encoding='gbk', errors='ignore') as f:
                      lines = f.readlines()

              converted_lines = []
              for line in lines:
                  res = clean_and_convert_line(line)
                  if res is not None:
                      converted_lines.append(res)

              os.makedirs(os.path.dirname(output_path), exist_ok=True)
              with open(output_path, 'w', encoding='utf-8') as f:
                  f.write('\n'.join(converted_lines) + '\n')

          source_dirs = ['qx', 'qxb']
          output_dir = 'rocket'

          for src_dir in source_dirs:
              if not os.path.exists(src_dir):
                  continue
              for root, _, files in os.walk(src_dir):
                  for file in files:
                      if file.endswith(('.list', '.txt', '.snippet', '.conf')):
                          src_file = os.path.join(root, file)
                          
                          # 去掉中间的 qx/qxb 层级，直接放在 rocket 目录下
                          rel_path = os.path.relpath(src_file, src_dir)
                          
                          # 统一输出为 .list 后缀文件
                          base_name = os.path.splitext(rel_path)[0]
                          dest_file = os.path.join(output_dir, f'{base_name}.list')
                          
                          process_file(src_file, dest_file)
                          print(f'Converted to DOMAIN-SET: {src_file} -> {dest_file}')
          "

      - name: Commit and Push Changes to Rocket Directory
        run: |
          git config --local user.email "github-actions[bot]@users.noreply.github.com"
          git config --local user.name "github-actions[bot]"
          
          git add rocket/
          
          if git diff --staged --quiet; then
            echo "No changes in rules, skipping commit."
          else
            git commit -m "auto: update shadowrocket domain-set rules in /rocket [skip ci]"
            git push
          fi
